NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=loopback
STORE_MODE=postgres
DATABASE_URL=postgresql://<game_db_user>:<game_db_password>@127.0.0.1:5432/<game_db_name>
PG_POOL_MAX=10
GAME_TIMEZONE=Asia/Ho_Chi_Minh

JWT_SECRET=<generate-a-long-random-secret>
JWT_TOKEN_TTL=30d
BCRYPT_ROUNDS=12
WEB_AUTH_MODE=disabled
AUTH_TRANSITION_MODE=local-primary
WEB_AUTH_LOGIN_URL=https://ywonder.net/api/game/auth
WEB_AUTH_SECRET=<web-game-api-secret>
LOCAL_REGISTRATION_ENABLED=false
BROWSER_AUTH_ENABLED=false
BROWSER_AUTH_LOGIN_URL=https://ywonder.net/vi/login
BROWSER_AUTH_CALLBACK_URL=https://ywonder.net/api/game/browser/callback
BROWSER_AUTH_TTL_MS=600000
BROWSER_AUTH_POLL_INTERVAL_MS=1000
BROWSER_AUTH_START_RATE_LIMIT_WINDOW_MS=600000
BROWSER_AUTH_START_RATE_LIMIT_MAX=30

ADMIN_DASHBOARD_ENABLED=false
DEMO_ACCOUNTS_ENABLED=false
HTTP_ACCESS_LOG=true
JSON_BODY_LIMIT=512kb
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
AUTH_IP_RATE_LIMIT_WINDOW_MS=600000
AUTH_IP_RATE_LIMIT_MAX=120
AUTH_IDENTITY_RATE_LIMIT_WINDOW_MS=900000
AUTH_IDENTITY_RATE_LIMIT_MAX=15
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=30
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
REALTIME_MAX_ROOM_PLAYERS=20
REALTIME_MAX_CONNECTIONS=100
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_MESSAGE_RATE_WINDOW_MS=10000
REALTIME_MESSAGE_RATE_MAX=300
REALTIME_MAX_BAD_MESSAGES=3
REALTIME_RESOURCE_RESPAWN_SEC=20
