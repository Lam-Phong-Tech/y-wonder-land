NODE_ENV=production
PORT=3000
STORE_MODE=postgres
DATABASE_URL=postgresql://<game_db_user>:<game_db_password>@127.0.0.1:5432/<game_db_name>
PG_POOL_MAX=10
GAME_TIMEZONE=Asia/Ho_Chi_Minh

JWT_SECRET=<generate-a-long-random-secret>
WEB_AUTH_MODE=disabled
WEB_AUTH_LOGIN_URL=https://ywonder.net/api/game/auth
WEB_AUTH_SECRET=<web-game-api-secret>

ADMIN_DASHBOARD_ENABLED=false
DEMO_ACCOUNTS_ENABLED=false
REALTIME_MAX_ROOM_PLAYERS=20
REALTIME_RESOURCE_RESPAWN_SEC=20
